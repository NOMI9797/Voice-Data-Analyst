# Copy to .env and fill in:  cp .env.example .env

# ---- LLM (API allowed by project rules) ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# ---- Local speech (must stay local) ----
WHISPER_MODEL=base.en
PIPER_VOICE=en_US-lessac-medium

# ---- Demo databases started by docker compose ----
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin_pw
POSTGRES_DB=olist
POSTGRES_READONLY_PASSWORD=reader_pw

MYSQL_ROOT_PASSWORD=root_pw
MYSQL_DATABASE=shop
MYSQL_READONLY_PASSWORD=reader_pw

# ---- Safety limits ----
QUERY_ROW_LIMIT=1000
QUERY_TIMEOUT_SECONDS=15
MAX_REPAIR_ATTEMPTS=3
